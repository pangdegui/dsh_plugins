{
  "name": "dsh-model-proxy",
  "version": "0.1.0",
  "description": "Route individual models through their own proxy in DeepSeek Harness. Only model requests are affected; everything else keeps its original network path.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "undici": "^8.11.2"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ]}
