{
  "name": "dsh-workbuddy",
  "version": "0.4.0",
  "description": "WorkBuddy (腾讯 WorkBuddy) account login and model routes for DeepSeek Harness: browser login, token rotation, and a pi-ai provider that exposes WorkBuddy's chat models in DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "test": "node test/unit.mjs && node test/wire.test.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workbuddy",
    "llm",
    "openai-compatible"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "files": [
    "lib/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
