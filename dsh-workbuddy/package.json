  "description": "WorkBuddy (腾讯 WorkBuddy) account login and model routes for DeepSeek Harness: browser login, token rotation, and a pi-ai provider that exposes WorkBuddy's chat models in DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
